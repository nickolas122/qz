# sprint.ride - eight seconds at 900 W out of a steady 180 W.
#
# For the peak-power tiles, the FIT file's max values and chart scaling. The rise and the fall
# are one second each, which is what makes this a test of whether a player can carry a short
# spike at all: anything that averages over a longer window than that loses the peak entirely.

mode        power
resistance  14

t=0     watts=180  cadence=88  hr=132
t=9     watts=180  cadence=88  hr=138
t=10    watts=900  cadence=115 hr=140
t=18    watts=900  cadence=112 hr=168
t=19    watts=180  cadence=85  hr=176
t=40    watts=180  cadence=86  hr=158
