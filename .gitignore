src/qdomyos-zwift.pro.user

.idea/

src/Makefile
src/.qmake.stash

# Building from the repository root - which is what the linux-x86-build job does,
# and what docs/fork/BUILDING-ON-WINDOWS.md describes for a local build - runs qmake on the
# subdirs project and generates these as well. Anchored to the root so the tracked
# src/ios/adb/libzipfile/Makefile.{am,in} are untouched.
/Makefile
/.qmake.stash
src/Makefile.qdomyos-zwift*
tst/Makefile*
tst/.qmake.stash

# The rest of what a root-level build leaves behind: the static library the tests
# link against, qmltyperegistrar's output, and the whole of tst/ - object files,
# moc output, the test binary and the FIT/sqlite files the suite writes.
src/libqdomyos-zwift.a
src/qdomyos-zwift.qmltypes
src/qdomyos-zwift_metatypes.json
src/qdomyos-zwift_qmltyperegistrations.cpp
tst/*.o
tst/moc_*
tst/qdomyos-zwift-tests
tst/test-artifacts/
tst/test-results/

# The suite writes these to a path relative to its working directory
# (tst/ToolTests/qfittestsuite.cpp), so where they land depends on where the binary
# was run from: tst/ for the CI job's `cd tst; ./qdomyos-zwift-tests`, and the repo
# root for `./tst/qdomyos-zwift-tests`. Both spellings, or running it the other way
# leaves an untracked directory behind.
/test-artifacts/
/test-results/

src/*.o

# What a local Windows mingw build leaves behind. Unlike the Linux layout above,
# qmake's win32-g++ spec puts every object, moc file and binary under a debug/ or
# release/ subdirectory, and generates the resource script and the @file lists the
# linker is handed.
src/debug/
src/release/
src/translations/debug/
src/translations/release/
tst/debug/
tst/release/
src/object_script.*
tst/object_script.*
src/qdomyos-zwift_resource.rc

src/moc_*
src/qrc_*

src/qdomyos-zwift

src/ui_charts.h
src/ui_mainwindow.h

src/build/*
src/build/*

src/debug-*

# QZ's debug logs, wherever they are run from. Two were once uploaded to the repo
# root through the GitHub web UI, which src/debug-* does not cover.
/debug-*.log

# The FIT backups QZ writes beside itself when the app is run from src/, which is how
# a simulated-bike session is started locally (docs/fork/VIRTUAL-BIKE.md).
src/*QZ-backup-*.fit
src/ddb.sqlite
src/training/

src/secret.h
src/secrets.h
secrets.h

*.swo
*.swp

